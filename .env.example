OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-6-luna
JARVIS_UI_THEME=dark
# JSON object mapping Jarvis-friendly names to a single executable name or absolute path.
JARVIS_APPLICATION_ALLOWLIST='{"zen":"zen-browser","zen browser":"zen-browser","browser":"zen-browser","terminal":"kitty","file manager":"thunar","steam":"steam","discord":"vesktop","code editor":"code"}'
CONVERSATION_TIMEOUT_SECONDS=12
STATUS_INDICATOR_ALWAYS_ON_TOP=true
STATUS_INDICATOR_STYLE=pill
# Hyprland only: pin the floating indicator across workspaces.
STATUS_INDICATOR_PERSISTENT=true
# Optional Hyprland output name, such as DP-1; blank uses its current monitor.
STATUS_INDICATOR_MONITOR=
# Pill dimensions in pixels (width 140-480, height 22-80); ignored for dot style.
STATUS_INDICATOR_WIDTH=150
STATUS_INDICATOR_HEIGHT=32
TERMINAL_APPROVAL_FLOATING=auto
TERMINAL_COMMANDS_ENABLED=false
TERMINAL_WRITE_ROOT=~/
# Map each source tier to an effective tier: 1=no approval, 2=approval, 3=deny.
# Downgrading Tier 2 or 3 can run writes inside TERMINAL_WRITE_ROOT without approval.
TERMINAL_TIER_1_OVERRIDE=1
TERMINAL_TIER_2_OVERRIDE=2
TERMINAL_TIER_3_OVERRIDE=3

# GPU Screen Recorder replay buffer
CLIP_MONITOR=DP-1
CLIP_DURATION=60
CLIP_FPS=60
CLIP_QUALITY=very_high
CLIP_CODEC=h264
CLIP_FORMAT=mp4
CLIP_AUDIO=default_output|default_input
CLIP_DIRECTORY=~/Videos/Clips
